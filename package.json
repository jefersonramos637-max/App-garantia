{
  "name": "app-garantias",
  "private": true,
  "version": "1.0.0",
  "description": "Registro e acompanhamento de garantias - Lojão dos Tratores / LL Tratores",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
