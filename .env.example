# Copie este arquivo para ".env.local" (desenvolvimento) ou cadastre estas
# variáveis no serviço de hospedagem (Cloudflare Pages / Netlify).
# Valores em: Supabase > Project Settings > API (ou "Connect").

# URL do projeto, ex.: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Chave PÚBLICA ("Publishable key" sb_publishable_... ou a antiga "anon key").
# NUNCA use a "secret key" / "service_role" aqui.
VITE_SUPABASE_ANON_KEY=

# Minutos sem uso até sair automaticamente (padrão 30).
VITE_INATIVIDADE_MINUTOS=30
