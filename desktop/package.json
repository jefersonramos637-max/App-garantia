{
  "name": "garantias-desktop",
  "productName": "Garantias",
  "version": "1.0.0",
  "description": "Garantias - Lojão dos Tratores / LL Tratores",
  "author": "Lojão dos Tratores",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "preparar": "node scripts/preparar.cjs",
    "iniciar": "npm run preparar && electron .",
    "pacote:windows": "npm run preparar && electron-builder --win nsis --x64 --publish never",
    "pacote:linux-teste": "npm run preparar && electron-builder --linux dir --publish never"
  },
  "build": {
    "appId": "br.com.lojaodostratores.garantias",
    "productName": "Garantias",
    "copyright": "Lojão dos Tratores",
    "directories": {
      "output": "saida"
    },
    "files": [
      "main.cjs",
      "configuracao.json",
      "icone.png",
      "package.json",
      "web/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icone.png",
      "artifactName": "Garantias-Instalador.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Garantias",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "dir",
      "icon": "icone.png",
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jefersonramos637-max",
        "repo": "App-garantia",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jefersonramos637-max/App-garantia.git"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
